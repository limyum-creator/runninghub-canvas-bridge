{
  "manifest_version": 3,
  "name": "RunningHub Canvas Bridge",
  "version": "0.5.0",
  "description": "Read and edit RunningHub infinite canvases through a local bridge.",
  "permissions": [],
  "host_permissions": [
    "https://www.runninghub.ai/project/canvas/*",
    "https://rhtv.runninghub.ai/project/canvas/*",
    "https://www.runninghub.cn/project/canvas/*",
    "https://rhtv.runninghub.cn/projects/canvas/*",
    "http://127.0.0.1:18765/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.runninghub.ai/project/canvas/*",
        "https://rhtv.runninghub.ai/project/canvas/*",
        "https://www.runninghub.cn/project/canvas/*",
        "https://rhtv.runninghub.cn/projects/canvas/*"
      ],
      "js": [
        "site-policy.js",
        "bridge-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "version_name": "0.5.0"
}
