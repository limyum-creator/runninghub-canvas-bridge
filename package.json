  },
  "bugs": {
    "url": "https://github.com/limyum-creator/runninghub-canvas-bridge/issues"
  },
  "homepage": "https://github.com/limyum-creator/runninghub-canvas-bridge#readme",
  "bin": {
    "runninghub-canvas-bridge": "bin/runninghub-canvas-bridge.mjs",
    "rh-canvas-bridge": "bin/runninghub-canvas-bridge.mjs",
    "runninghub-canvas-mcp": "server/mcp.mjs"
  },
  "files": [
    "bin/",
    "docs/",
    "extension/",
    "scripts/",
    "server/",
    "AGENT_QUICKSTART.md",
    "AGENT_INSTALL.md",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "UPSTREAM.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node server/server.mjs",
    "check": "node --check server/server.mjs && node --check server/bridge-runtime.js && node --check extension/bridge-main.js && node --check scripts/rh-bridge.mjs && node --check scripts/rh-service.mjs && node --check bin/runninghub-canvas-bridge.mjs && node --check scripts/package-release.mjs && node --check extension/site-policy.js && node --check server/mcp.mjs && node --check server/archive.mjs && node --check server/media.mjs && node --check server/lumen.mjs && node --check server/bridge-client.mjs",
    "bridge": "node scripts/rh-bridge.mjs",
    "cli": "node bin/runninghub-canvas-bridge.mjs",
    "release:check": "npm run check && npm pack --dry-run",
    "release:package": "node scripts/package-release.mjs",
    "service:install": "node scripts/rh-service.mjs install",
    "service:start": "node scripts/rh-service.mjs start",
    "service:status": "node scripts/rh-service.mjs status",
    "service:restart": "node scripts/rh-service.mjs restart",
    "service:uninstall": "node scripts/rh-service.mjs uninstall",
    "build": "node scripts/build-vendor.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepack": "npm run build",
    "mcp": "node server/mcp.mjs"
  },
  "private": true,
  "modificationNotice": "Modified 2026-09-27: international canvas support and guarded local bridge.",
